      {
        "id": "https://openalex.org/W7230087996",
        "doi": "10.1016/j.measurement.2026.123869",
        "title": "Long distance optical frequency transfer with short-term phase noise suppressed by a clean-up-supported remote terminal",
        "published": "2026-11-01",
        "url": "https://doi.org/10.1016/j.measurement.2026.123869",
        "authors": [
          "Przemysław Krehlik",
          "Tomasz Kawalec",
          "Jakub Dobosz",
          "Marcin Bober",
          "Krzysztof Turza",
          "Łukasz Śliwczyński",
          "Łukasz Buczek",
          "Antoni Weglarz",
          "Adam M. Wojciechowski",
          "Mariusz Semczuk"
        ],
        "institutions": [
          "AGH University of Krakow",
          "Jagiellonian University",
          "University of Warsaw",
          "Nicolaus Copernicus University",
          "Poznan Supercomputing and Networking Center"
        ],
        "journal": "Measurement",
        "abstract": "We demonstrate long-distance optical frequency transfer with improved short-term stability using a clean-up-supported remote terminal. Standard fiber links with active phase noise cancellation achieve excellent long-term performance, but leave residual noise at short timescales which makes the real-time use difficult. To address this problem, we implemented a transportable clean-up system at the remote end of a 650 km stabilized fiber link. The system, based on a laser locked to a commercial ultra-stable cavity, effectively suppresses the residual noise and restores a narrow-line optical reference suitable for direct applications. We show that such terminals enable reliable frequency dissemination to remote laboratories and are well suited for future national and international networks.",
        "citation_count": 0,
        "method": "Experimental"
      }
